# Railway Variables — only non-secret examples. Never commit actual bot tokens.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN_FROM_BOTFATHER
# Telegram numeric user IDs; no passwords or login.
TELEGRAM_ID_1=REPLACE_WITH_YOUR_NUMERIC_TELEGRAM_USER_ID
TELEGRAM_ID_2=OPTIONAL_SECOND_NUMERIC_USER_ID
# Add TELEGRAM_ID_3, _4, etc. Only listed users can download videos.
WEBHOOK_SECRET=replace_with_32_random_url_safe_chars
# Railway sets RAILWAY_PUBLIC_DOMAIN after Generate Domain.
# WEBHOOK_BASE_URL=https://your-video-bot.up.railway.app
BOT_MODE=eco
MAX_FILE_MB=45
MAX_QUEUE=20
DOWNLOAD_TIMEOUT=3600
UPLOAD_TIMEOUT=3600
# ALLOWED_DOMAINS=youtube.com,youtu.be,instagram.com,tiktok.com,facebook.com,fb.watch,x.com,twitter.com,pinterest.com,pin.it,vimeo.com,dailymotion.com
# BLOCKED_DOMAINS=example.com,another.example

# Optional large-files mode: requires a SECOND always-on Local Telegram Bot API service.
# BOT_MODE=large
# MAX_FILE_MB=1900
# TELEGRAM_API_BASE=http://telegram-api.railway.internal:8081
# TELEGRAM_API_ID=your_id_from_my_telegram_org
# TELEGRAM_API_HASH=your_hash_from_my_telegram_org
